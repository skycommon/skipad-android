{
  "_说明": "改完点保存即可生效。字段含义见应用内 README 或仓库 README.md 第四节。",

  "global": {
    "watchAll": true,
    "scanIntervalMs": 100,
    "pollIntervalMs": 250,
    "maxTextLen": 8,
    "maxWaitMs": 15000,
    "retryLimit": 8,
    "continueAfterSkip": false,
    "blindTapEnabled": false,
    "blindTapX": 0.86,
    "blindTapY": 0.07,

    "safeMode": true,
    "splashWindowMs": 6000,
    "episodeCooldownMs": 60000,
    "verifyBeforeTap": true,
    "safeMaxArea": 0.12,
    "safeTopBand": 0.30,
    "safeBottomBand": 0.75
  },

  "skipTexts": [
    "跳过",
    "跳过广告",
    "跳过此广告",
    "关闭广告",
    "关闭此广告",
    "点击跳过",
    "跳过 >",
    "跳过>>",
    "跳过广告 >",
    "Skip",
    "Skip Ad",
    "Skip Ads",
    "SKIP"
  ],

  "strongTexts": [
    "跳过",
    "关闭广告",
    "跳过广告"
  ],

  "denyTexts": [
    "跳过此步骤",
    "跳过此步",
    "跳过引导",
    "跳过教程",
    "跳过学习",
    "跳过验证",
    "跳过登录",
    "跳过新手",
    "暂不跳过",
    "取消"
  ],

  "skipIds": [
    "*:*skip*",
    "*:*close_ad*",
    "*:*closead*",
    "*:*ad_close*",
    "*:*close_ads*",
    "*:*ad_skip*",
    "*:*skip_ad*"
  ],

  "excludeApps": [
    "com.android.settings",
    "com.android.systemui",
    "com.android.launcher",
    "com.android.launcher3",
    "com.google.android.apps.nexuslauncher",
    "com.miui.home",
    "com.huawei.android.launcher",
    "com.oppo.launcher",
    "com.vivo.launcher",
    "com.bbk.launcher2",
    "com.android.vending",
    "com.google.android.packageinstaller",
    "com.android.packageinstaller",
    "com.android.permissioncontroller",
    "com.lbx.skipad"
  ],

  "apps": {
    "com.tencent.qqmusic": {
      "name": "QQ音乐",
      "enabled": true,
      "extraTexts": [
        "跳过",
        "关闭广告",
        "跳过广告"
      ],
      "extraIds": [
        "*:*skip*",
        "*:*splash*",
        "*:*ad*close*",
        "*:*close*ad*"
      ]
    },
    "com.ss.android.ugc.aweme": {
      "name": "抖音",
      "enabled": true,
      "extraTexts": [
        "跳过",
        "跳过广告"
      ],
      "extraIds": []
    }
  }
}
